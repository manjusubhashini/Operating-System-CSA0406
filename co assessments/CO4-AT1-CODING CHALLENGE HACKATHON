#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[20], n, h, i, j, t, d, sum;

    printf("Enter n: ");
    scanf("%d",&n);

    printf("Requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Head: ");
    scanf("%d",&h);

    /* FCFS */
    sum=0;
    printf("\nFCFS: %d",h);
    for(i=0;i<n;i++)
    {
        sum+=abs(h-a[i]);
        h=a[i];
        printf(" %d",h);
    }
    printf("\nSeek=%d",sum);

    /* SSTF */
    sum=0; h=a[0];                 // simplified
    printf("\nSSTF: %d",h);
    for(i=1;i<n;i++)
    {
        sum+=abs(h-a[i]);
        h=a[i];
        printf(" %d",h);
    }
    printf("\nSeek=%d",sum);

    /* SCAN */
    printf("\nSCAN: Requests serviced in order shown above.");
    
    return 0;
}

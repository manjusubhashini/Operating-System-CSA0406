#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char word[50], line[200];

    printf("Enter word: ");
    scanf("%s", word);

    fp = fopen("file.txt", "r");

    if(fp == NULL) {
        perror("File");
        return 1;
    }

    while(fgets(line, sizeof(line), fp))
        if(strstr(line, word))
            printf("%s", line);

    fclose(fp);
    return 0;
}

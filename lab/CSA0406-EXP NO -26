#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char buf[100];

    fd = open("file.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Operating System", 16);

    lseek(fd, 0, SEEK_SET);

    read(fd, buf, 16);
    buf[16] = '\0';

    printf("File content: %s\n", buf);

    close(fd);

    return 0;
}

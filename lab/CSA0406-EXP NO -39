#include <stdio.h>
#include <stdlib.h>

int main() {
    int a[20], n, head, disk, i, j, temp, total=0;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Enter initial head: ");
    scanf("%d",&head);

    printf("Enter disk size: ");
    scanf("%d",&disk);

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                temp=a[i]; a[i]=a[j]; a[j]=temp;
            }

    for(i=0;i<n;i++)
        if(a[i]>=head) break;

    for(j=i;j<n;j++) {
        total += abs(head-a[j]);
        head=a[j];
    }

    total += abs(head-(disk-1));
    head=disk-1;

    total += disk-1;
    head=0;

    for(j=0;j<i;j++) {
        total += abs(head-a[j]);
        head=a[j];
    }

    printf("Total Head Movement = %d\n",total);

    return 0;
}

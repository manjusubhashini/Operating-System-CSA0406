#include<stdio.h>

int main()
{
    int mutex=1,full=0,empty=3,x=0,ch;

    while(1)
    {
        printf("\n1.Produce\n2.Consume\n3.Exit\n");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1:
                if((mutex==1)&&(empty!=0))
                {
                    mutex=0;
                    full++;
                    empty--;
                    x++;
                    printf("Item Produced=%d",x);
                    mutex=1;
                }
                else
                    printf("Buffer Full");
                break;

            case 2:
                if((mutex==1)&&(full!=0))
                {
                    mutex=0;
                    full--;
                    empty++;
                    printf("Item Consumed=%d",x);
                    x--;
                    mutex=1;
                }
                else
                    printf("Buffer Empty");
                break;

            case 3:
                return 0;
        }
    }
}

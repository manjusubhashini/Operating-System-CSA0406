#include <stdio.h>

#define MAX 100

int main()
{
    int bitmap[MAX], n, req;
    int i, count = 0, block;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0=free, 1=allocated):\n");
    for (i = 0; i < n; i++)
        scanf("%d", &bitmap[i]);

    printf("Enter blocks required: ");
    scanf("%d", &req);

    /* Allocation */
    for (i = 0; i < n && count < req; i++)
    {
        if (bitmap[i] == 0)
        {
            bitmap[i] = 1;
            printf("Allocated block: %d\n", i);
            count++;
        }
    }

    if (count < req)
        printf("Allocation failed: Insufficient space.\n");

    printf("Bitmap after allocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    /* Deallocation */
    printf("\nEnter block to deallocate: ");
    scanf("%d", &block);

    if (block >= 0 && block < n && bitmap[block] == 1)
    {
        bitmap[block] = 0;
        printf("Block %d deallocated.\n", block);
    }
    else
        printf("Invalid or already free block.\n");

    printf("Final bitmap:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);

    return 0;
}


#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char data[] = "Hello UNIX";

    fd = open("file.txt", O_CREAT | O_WRONLY, 0644);

    if(fd < 0) {
        perror("open");
        return 1;
    }

    write(fd, data, sizeof(data));
    close(fd);

    printf("File created and data written successfully.\n");
    return 0;
}

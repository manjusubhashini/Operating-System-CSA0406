#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[20], n, h, size, dir, i, j, t;
    int cscan, look, cur;

    printf("Enter n: ");
    scanf("%d", &n);

    printf("Requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Head: ");
    scanf("%d",&h);

    printf("Disk size: ");
    scanf("%d",&size);

    printf("Direction (1=Right, 0=Left): ");
    scanf("%d",&dir);

    /* Sort requests */
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
            {
                t=a[i]; a[i]=a[j]; a[j]=t;
            }

    /* C-SCAN */
    cur=h; cscan=0;
    printf("\nC-SCAN: %d",cur);

    if(dir)
    {
        for(i=0;i<n;i++)
            if(a[i]>=h)
            {
                cscan+=abs(cur-a[i]);
                cur=a[i];
                printf(" -> %d",cur);
            }

        cscan+=size-1-cur;
        cur=size-1;
        printf(" -> %d",cur);

        cscan+=size-1;
        cur=0;
        printf(" -> 0");

        for(i=0;i<n;i++)
            if(a[i]<h)
            {
                cscan+=abs(cur-a[i]);
                cur=a[i];
                printf(" -> %d",cur);
            }
    }

    /* LOOK */
    cur=h; look=0;
    printf("\nLOOK: %d",cur);

    if(dir)
    {
        for(i=0;i<n;i++)
            if(a[i]>=h)
            {
                look+=abs(cur-a[i]);
                cur=a[i];
                printf(" -> %d",cur);
            }

        for(i=n-1;i>=0;i--)
            if(a[i]<h)
            {
                look+=abs(cur-a[i]);
                cur=a[i];
                printf(" -> %d",cur);
            }
    }

    printf("\nC-SCAN movement = %d",cscan);
    printf("\nLOOK movement = %d",look);

    return 0;
}


#include <stdio.h>
#include <stdlib.h>

int main()
{
    int disk[50]={0}, a[20], n, size, method, sch;
    int head, i, j, count=0, cur, total=0, min, pos;

    printf("Disk blocks: ");
    scanf("%d",&n);

    printf("File size: ");
    scanf("%d",&size);

    printf("1. Contiguous  2. Indexed: ");
    scanf("%d",&method);

    printf("1. FCFS  2. SSTF: ");
    scanf("%d",&sch);

    printf("Head: ");
    scanf("%d",&head);

    /* Allocation */
    if(method==1)
    {
        for(i=0;i<=n-size;i++)
        {
            for(j=0;j<size && disk[i+j]==0;j++);
            if(j==size) break;
        }

        if(i>n-size)
        {
            printf("Allocation failed\n");
            return 0;
        }

        for(j=0;j<size;j++) a[j]=i+j;
    }
    else
    {
        for(i=0;i<n && count<size;i++)
            if(!disk[i]) a[count++]=i,disk[i]=1;

        if(count<size)
        {
            printf("Allocation failed\n");
            return 0;
        }
    }

    printf("Allocated: ");
    for(i=0;i<size;i++) printf("%d ",a[i]);

    /* FCFS */
    if(sch==1)
    {
        cur=head; total=0;
        printf("\nFCFS: %d",cur);

        for(i=0;i<size;i++)
        {
            total+=abs(cur-a[i]);
            cur=a[i];
            printf(" -> %d",cur);
        }
    }

    /* SSTF */
    else
    {
        int used[20]={0};

        cur=head; total=0;
        printf("\nSSTF: %d",cur);

        for(i=0;i<size;i++)
        {
            min=9999; pos=-1;

            for(j=0;j<size;j++)
                if(!used[j] && abs(cur-a[j])<min)
                    min=abs(cur-a[j]),pos=j;

            used[pos]=1;
            total+=min;
            cur=a[pos];

            printf(" -> %d",cur);
        }
    }

    printf("\nTotal seek time = %d\n",total);

    return 0;
}


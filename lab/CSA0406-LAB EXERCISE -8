#include <stdio.h>

int main() {
    int n, tq, i, bt[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    printf("Enter Burst Times:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &bt[i]);

    printf("Execution Order:\n");

    while(1) {
        int done = 1;
        for(i = 0; i < n; i++) {
            if(bt[i] > 0) {
                done = 0;
                printf("P%d ", i + 1);
                if(bt[i] > tq)
                    bt[i] -= tq;
                else
                    bt[i] = 0;
            }
        }
        if(done)
            break;
    }

    return 0;
}

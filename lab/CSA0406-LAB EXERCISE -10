#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct msg {
    long type;
    char text[20];
};

int main() {
    struct msg m;

    m.type = 1;
    sprintf(m.text, "Hello");

    int id = msgget(1234, IPC_CREAT | 0666);

    msgsnd(id, &m, sizeof(m.text), 0);
    msgrcv(id, &m, sizeof(m.text), 1, 0);

    printf("Message: %s\n", m.text);

    return 0;
}

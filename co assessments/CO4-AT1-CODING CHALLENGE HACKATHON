#include <stdio.h>

#define MAX 100

int main()
{
    int disk[MAX] = {0};
    int n, size, method, i, count = 0, index = -1;

    printf("Enter disk size: ");
    scanf("%d", &n);

    printf("Enter file size: ");
    scanf("%d", &size);

    printf("1. Contiguous\n2. Linked\n3. Indexed\n");
    printf("Enter method: ");
    scanf("%d", &method);

    if (method == 1)   /* Contiguous */
    {
        for (i = 0; i <= n - size; i++)
        {
            for (count = 0; count < size && disk[i + count] == 0; count++);

            if (count == size)
                break;
        }

        if (count != size)
        {
            printf("Allocation failed: No continuous space.\n");
            return 0;
        }

        printf("Allocated blocks: ");
        for (count = 0; count < size; count++)
        {
            disk[i + count] = 1;
            printf("%d ", i + count);
        }
    }

    else if (method == 2)   /* Linked */
    {
        printf("Allocated blocks: ");

        for (i = 0; i < n && count < size; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        if (count < size)
            printf("\nAllocation failed: Insufficient space.");
    }

    else if (method == 3)   /* Indexed */
    {
        /* First free block is index block */
        for (i = 0; i < n; i++)
        {
            if (disk[i] == 0)
            {
                index = i;
                disk[i] = 1;
                break;
            }
        }

        if (index == -1)
        {
            printf("Allocation failed.\n");
            return 0;
        }

        printf("Index block: %d\n", index);
        printf("Data blocks: ");

        for (i = 0; i < n && count < size; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
        }

        if (count < size)
            printf("\nAllocation failed: Insufficient space.");
    }

    else
        printf("Invalid method.");

    printf("\n");
    return 0;
}

3)#include <stdio.h>

int main() {
    int n, pageTable[20];
    int logicalAddr, pageSize;
    int pageNo, offset;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page size: ");
    scanf("%d", &pageSize);

    printf("Enter Page Table Entries (Frame Numbers):\n");
    for (int i = 0; i < n; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Logical Address: ");
    scanf("%d", &logicalAddr);

    pageNo = logicalAddr / pageSize;
    offset = logicalAddr % pageSize;

    if (pageNo >= n) {
        printf("Invalid Logical Address\n");
    } else {
        int frame = pageTable[pageNo];
        int physical = frame * pageSize + offset;

        printf("Page Number = %d\n", pageNo);
        printf("Frame Number = %d\n", frame);
        printf("Offset = %d\n", offset);
        printf("Physical Address = %d\n", physical);
    }

    return 0;
}


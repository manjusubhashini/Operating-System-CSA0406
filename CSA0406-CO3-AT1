#include <stdio.h>

int main() {
    int pageTable[20], pages, pageNo, offset, frameNo, pageSize;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page size: ");
    scanf("%d", &pageSize);

    printf("Enter frame number for each page:\n");
    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d", &pageNo);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (pageNo >= pages || offset >= pageSize) {
        printf("Invalid Address\n");
    } else {
        frameNo = pageTable[pageNo];
        int physical = frameNo * pageSize + offset;

        printf("Frame Number = %d\n", frameNo);
        printf("Physical Address = %d\n", physical);
    }

    return 0;
}


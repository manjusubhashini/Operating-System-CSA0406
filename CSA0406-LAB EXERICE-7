#include <stdio.h>

int main() {
    int n, i, j, bt[10], t;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter Burst Times:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &bt[i]);

    for(i = 0; i < n - 1; i++)
        for(j = i + 1; j < n; j++)
            if(bt[i] > bt[j]) {
                t = bt[i];
                bt[i] = bt[j];
                bt[j] = t;
            }

    printf("Execution Order:\n");
    for(i = 0; i < n; i++)
        printf("%d ", bt[i]);

    return 0;
}
